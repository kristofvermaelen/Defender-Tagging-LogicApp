{
    "id": "Defeder-Tagging-LogicApp",
    "title": "Defeder-Tagging-LogicApp",
    "description": "Defeder-Tagging-LogicApp\n",
    "iconType": "ScheduledTask",
    "skuType": "Consumption",
    "data": {
        "definition": {
            "metadata": {
                "notes": {
                    "1FF72097-7D33-4D35-942B-C482DCAF5507": {
                        "content": "Create a filter string to filter out all Tags from UniqueTags.\nThis filterstring can be used when pulling all assets",
                        "color": "#CCE5FF",
                        "metadata": {
                            "position": {
                                "x": 660,
                                "y": 580
                            },
                            "width": 444,
                            "height": 64
                        }
                    },
                    "F553592E-91B0-4B9B-9114-A29380312BF0": {
                        "content": "Get All Tags from the Variable CTEM_Tagging_Rules",
                        "color": "#CCE5FF",
                        "metadata": {
                            "position": {
                                "x": 660,
                                "y": 340
                            },
                            "width": 443,
                            "height": 44
                        }
                    },
                    "731481E9-4A58-4169-845B-E8CB9D4B509E": {
                        "content": "Only keep the Unique Tags from AllTags",
                        "color": "#CCE5FF",
                        "metadata": {
                            "position": {
                                "x": 640,
                                "y": 460
                            },
                            "width": 443,
                            "height": 44
                        }
                    },
                    "3D4D017A-ADD0-44FA-912A-09EF9645598B": {
                        "content": "TimeRange used in Defender API when pulling all assets",
                        "color": "#CCE5FF",
                        "metadata": {
                            "position": {
                                "x": 680,
                                "y": 120
                            },
                            "width": 416,
                            "height": 44
                        }
                    }
                }
            },
            "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
            "contentVersion": "1.0.0.0",
            "parameters": {
                "$connections": {
                    "defaultValue": {},
                    "type": "Object"
                }
            },
            "triggers": {
                "Recurrence": {
                    "recurrence": {
                        "interval": 3,
                        "frequency": "Month"
                    },
                    "evaluatedRecurrence": {
                        "interval": 3,
                        "frequency": "Month"
                    },
                    "type": "Recurrence"
                }
            },
            "actions": {
                "AllTags": {
                    "runAfter": {
                        "Initialize_Variables": [
                            "Succeeded"
                        ]
                    },
                    "type": "Select",
                    "inputs": {
                        "from": "@variables('CTEM_Tagging_Rules')?['rules']",
                        "select": "@item()?['tag']"
                    }
                },
                "TagFilterString": {
                    "runAfter": {
                        "UniqueTagsWithCatchAll": [
                            "Succeeded"
                        ]
                    },
                    "type": "Compose",
                    "inputs": "@concat('(t: t eq ''', join( outputs('UniqueTags'), ''' or t eq '''), ''')')"
                },
                "Machines_-_Get_list_of_machines": {
                    "runAfter": {
                        "Retagging": [
                            "Succeeded"
                        ]
                    },
                    "type": "ApiConnection",
                    "inputs": {
                        "host": {
                            "connection": {
                                "name": "@parameters('$connections')['wdatp-1']['connectionId']"
                            }
                        },
                        "method": "get",
                        "path": "/api/machines",
                        "queries": {
                            "$filter": "@variables('FilterString')"
                        }
                    },
                    "runtimeConfiguration": {
                        "paginationPolicy": {
                            "minimumItemCount": 100000
                        }
                    }
                },
                "For_Each_Machine": {
                    "foreach": "@body('Machines_-_Get_list_of_machines')?['value']",
                    "actions": {
                        "Apply_Filter": {
                            "type": "Query",
                            "inputs": {
                                "from": "@variables('CTEM_Tagging_Rules')?['rules']",
                                "where": "@and(\n  or(empty(item()?['computerDnsName']?['contains']), contains(toLower(coalesce(items('For_Each_Machine')?['computerDnsName'], '')), toLower(coalesce(item()?['computerDnsName']?['contains'], '')))),\n  or(empty(item()?['computerDnsName']?['startsWith']), startsWith(toLower(coalesce(items('For_Each_Machine')?['computerDnsName'], '')), toLower(coalesce(item()?['computerDnsName']?['startsWith'], '')))),\n  or(empty(item()?['computerDnsName']?['endsWith']), endsWith(toLower(coalesce(items('For_Each_Machine')?['computerDnsName'], '')), toLower(coalesce(item()?['computerDnsName']?['endsWith'], '')))),\n\n  or(empty(item()?['osPlatform']?['contains']), contains(toLower(coalesce(items('For_Each_Machine')?['osPlatform'], '')), toLower(coalesce(item()?['osPlatform']?['contains'], '')))),\n  or(empty(item()?['osPlatform']?['startsWith']), startsWith(toLower(coalesce(items('For_Each_Machine')?['osPlatform'], '')), toLower(coalesce(item()?['osPlatform']?['startsWith'], '')))),\n  or(empty(item()?['osPlatform']?['endsWith']), endsWith(toLower(coalesce(items('For_Each_Machine')?['osPlatform'], '')), toLower(coalesce(item()?['osPlatform']?['endsWith'], '')))),\n  or(empty(item()?['osPlatform']?['equals']), equals(toLower(coalesce(items('For_Each_Machine')?['osPlatform'], '')), toLower(coalesce(item()?['osPlatform']?['equals'], '')))),\n\n  or(empty(item()?['lastIpAddress']?['startsWith']), startsWith(coalesce(items('For_Each_Machine')?['lastIpAddress'], ''), coalesce(item()?['lastIpAddress']?['startsWith'], ''))),\n\n  or(empty(item()?['rbacGroupName']?['contains']), contains(toLower(coalesce(items('For_Each_Machine')?['rbacGroupName'], '')), toLower(coalesce(item()?['rbacGroupName']?['contains'], '')))),\n  or(empty(item()?['rbacGroupName']?['startsWith']), startsWith(toLower(coalesce(items('For_Each_Machine')?['rbacGroupName'], '')), toLower(coalesce(item()?['rbacGroupName']?['startsWith'], '')))),\n  or(empty(item()?['rbacGroupName']?['endsWith']), endsWith(toLower(coalesce(items('For_Each_Machine')?['rbacGroupName'], '')), toLower(coalesce(item()?['rbacGroupName']?['endsWith'], '')))),\n  or(empty(item()?['rbacGroupName']?['equals']), equals(toLower(coalesce(items('For_Each_Machine')?['rbacGroupName'], '')), toLower(coalesce(item()?['rbacGroupName']?['equals'], '')))),\n\n  or(empty(item()?['machineTags']?['equals']), contains(coalesce(items('For_Each_Machine')?['machineTags'], json('[]')), item()?['machineTags']?['equals'])),\n\n  or(empty(item()?['onboardingStatus']?['equals']), equals(toLower(coalesce(items('For_Each_Machine')?['onboardingStatus'], '')), toLower(coalesce(item()?['onboardingStatus']?['equals'], '')))),\n\n  or(empty(item()?['managedBy']?['equals']), equals(toLower(coalesce(items('For_Each_Machine')?['managedBy'], '')), toLower(coalesce(item()?['managedBy']?['equals'], '')))),\n  or(equals(item()?['isAadJoined']?['equals'], null),equals(items('For_Each_Machine')?['isAadJoined'],item()?['isAadJoined']?['equals']))\n)"
                            }
                        },
                        "ExistingAutoTags": {
                            "runAfter": {
                                "ExistingManualTags": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Compose",
                            "inputs": "@intersection(\n  coalesce(item()?['machineTags'], json('[]')),\n  outputs('UniqueTagsWithCatchAll')\n)"
                        },
                        "ExistingManualTags": {
                            "runAfter": {
                                "MatchedTags": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Compose",
                            "inputs": "@intersection(\n  coalesce(item()?['machineTags'], json('[]')),\n  variables('ManualTags')\n)"
                        },
                        "DesiredAutoTags": {
                            "runAfter": {
                                "ExistingAutoTags": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Compose",
                            "inputs": "@if(\n  not(empty(outputs('ExistingManualTags'))),\n  json('[]'),\n  if(\n    empty(body('MatchedTags')),\n    array(variables('CatchAllTag')),\n    union(body('MatchedTags'), body('MatchedTags'))\n  )\n)"
                        },
                        "TagsToAdd": {
                            "runAfter": {
                                "DesiredAutoTags": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Query",
                            "inputs": {
                                "from": "@outputs('DesiredAutoTags')",
                                "where": "@not(contains(outputs('ExistingAutoTags'), item()))"
                            }
                        },
                        "TagsToRemove": {
                            "runAfter": {
                                "TagsToAdd": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Query",
                            "inputs": {
                                "from": "@outputs('ExistingAutoTags')",
                                "where": "@not(contains(outputs('DesiredAutoTags'), item()))"
                            }
                        },
                        "HasTagChanges": {
                            "actions": {
                                "Append_to_ReportRows": {
                                    "type": "AppendToArrayVariable",
                                    "inputs": {
                                        "name": "ReportRows",
                                        "value": {
                                            "MachineId": "@{item()?['id']}",
                                            "computerDnsName": "@{item()?['computerDnsName']}",
                                            "osPlatform": "@{item()?['osPlatform']}",
                                            "lastIpAddress": "@{item()?['lastIpAddress']}",
                                            "rbacGroupName": "@{item()?['rbacGroupName']}",
                                            "machineTags": "@{join(coalesce(item()?['machineTags'], json('[]')), ', ')}",
                                            "onboardingStatus": "@{item()?['onboardingStatus']}",
                                            "isAadJoined": "@{item()?['isAadJoined']}",
                                            "managedBy": "@{item()?['managedBy']}",
                                            "Manualtags": "@{join(outputs('ExistingManualTags'), ', ')}",
                                            "ExistingTags": "@{join(outputs('ExistingAutoTags'), ', ')}",
                                            "TagToAdd": "@{join(body('TagsToAdd'), ', ')}",
                                            "TagToRemove": "@{join(body('TagsToRemove'), ', ')}"
                                        }
                                    }
                                }
                            },
                            "runAfter": {
                                "TagsToRemove": [
                                    "Succeeded"
                                ]
                            },
                            "else": {
                                "actions": {}
                            },
                            "expression": "@or(not(empty(body('TagsToAdd'))), not(empty(body('TagsToRemove'))))",
                            "type": "If"
                        },
"MatchedTags": {
                            "runAfter": {
                                "Apply_Filter": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Select",
                            "inputs": {
                                "from": "@body('Apply_Filter')",
                                "select": "@item()?['tag']"
                            }
                        }
                    },
                    "runAfter": {
                        "Machines_-_Get_list_of_machines": [
                            "Succeeded"
                        ]
                    },
                    "type": "Foreach"
                },
                "Initialize_Variables": {
                    "runAfter": {
                        "Compose_-_1months": [
                            "Succeeded"
                        ]
                    },
                    "type": "InitializeVariable",
                    "inputs": {
                        "variables": [
                            {
                                "name": "RunMode",
                                "type": "string",
                                "value": "CsvEmail"
                            },
                            {
                                "name": "ReportRows",
                                "type": "array",
                                "value": []
                            },
