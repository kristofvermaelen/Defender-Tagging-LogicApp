                },
                "Runmode_-_Email": {
                    "actions": {
                        "Send_Email_(V3)": {
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['smtp']['connectionId']"
                                    }
                                },
                                "method": "post",
                                "body": {
                                    "Attachments": [
                                        {
                                            "ContentData": "@base64(body('Create_CSV_table'))",
                                            "FileName": "NewTags.csv"
                                        }
                                    ],
                                    "To": "kristof.vermaelen.ext@proximusnxt.com",
                                    "Subject": "CTEM : New proposed taggings",
                                    "Body": "<p class=\"editor-paragraph\">In bijlage de nieuwe voorgestelde tags</p>"
                                },
                                "path": "/SendEmailV3"
                            }
                        }
                    },
                    "runAfter": {
                        "Create_CSV_table": [
                            "Succeeded"
                        ]
                    },
                    "else": {
                        "actions": {}
                    },
                    "expression": {
                        "and": [
                            {
                                "contains": [
                                    "@variables('RunMode')",
                                    "Email"
                                ]
                            }
                        ]
                    },
                    "type": "If"
                },
                "Create_CSV_table": {
                    "runAfter": {
                        "For_Each_Machine": [
                            "Succeeded"
                        ]
                    },
                    "type": "Table",
                    "inputs": {
                        "from": "@variables('ReportRows')",
                        "format": "CSV"
                    }
                },
                "Compose_-_1months": {
                    "runAfter": {},
                    "type": "Compose",
                    "inputs": "@addToTime(utcNow(), -7, 'Day')"
                },
                "Retagging": {
                    "actions": {
                        "FilterString_Without_Tags": {
                            "type": "SetVariable",
                            "inputs": {
                                "name": "FilterString",
                                "value": "lastSeen ge @{outputs('Compose_-_1months')}"
                            }
                        }
                    },
                    "runAfter": {
                        "TagFilterString": [
                            "Succeeded"
                        ]
                    },
                    "else": {
                        "actions": {
                            "FilterString_With_Tags": {
                                "type": "SetVariable",
                                "inputs": {
                                    "name": "FilterString",
                                    "value": "not(machineTags/any@{outputs('TagFilterString')}) and lastSeen ge @{outputs('Compose_-_1months')}"
                                }
                            }
                        }
                    },
                    "expression": {
                        "and": [
                            {
                                "equals": [
                                    "@variables('Retagging')",
                                    true
                                ]
                            }
                        ]
                    },
                    "type": "If"
                },
                "UniqueTags": {
                    "runAfter": {
                        "AllTags": [
                            "Succeeded"
                        ]
                    },
                    "type": "Compose",
                    "inputs": "@union(body('AllTags'), body('AllTags'))"
                },
                "UniqueTagsWithCatchAll": {
                    "runAfter": {
                        "UniqueTags": [
                            "Succeeded"
                        ]
                    },
                    "type": "Compose",
                    "inputs": "@union(\n  body('AllTags'),\n  array(variables('CatchAllTag'))\n)"
                }
            },
            "outputs": {}
        },
        "parameters": {},
        "connections": {
            "wdatp-1": {
                "id": "/subscriptions/0000-0000/providers/Microsoft.Web/locations/northeurope/managedApis/wdatp",
                "connectionId": "",
                "connectionName": ""
            },
            "smtp": {
                "id": "/subscriptions/0000-0000/providers/Microsoft.Web/locations/northeurope/managedApis/smtp",
                "connectionId": "",
                "connectionName": ""
            }
        }
    }
}